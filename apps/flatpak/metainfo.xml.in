<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@D2D_FLATPAK_APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Diablo 2 Couch</name>
  <summary>Diablo II couch co-op: up to four players on one screen</summary>
  <description>
    <p>Diablo 2 Couch is a modified version of D2Decomp, an open source engine for playing Diablo II, that adds local co-op with controllers on one shared screen. The game data is provided separately by the player.</p>
  </description>
  <launchable type="desktop-id">@D2D_FLATPAK_APP_ID@.desktop</launchable>
  <url type="homepage">https://github.com/jarvis-jhk/diablo2-couch</url>
</component>
